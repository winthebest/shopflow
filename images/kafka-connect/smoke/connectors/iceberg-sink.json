{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "1",
  "topics": "shop.public.customers,shop.public.orders,shop.public.heartbeat",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "topic,ingested",
  "transforms.topic.type": "org.apache.kafka.connect.transforms.InsertField$Value",
  "transforms.topic.topic.field": "_topic",
  "transforms.ingested.type": "org.apache.kafka.connect.transforms.InsertField$Value",
  "transforms.ingested.timestamp.field": "_ingested_at",
  "iceberg.tables": "bronze.customers,bronze.orders,bronze.heartbeat",
  "iceberg.tables.route-field": "_topic",
  "iceberg.table.bronze.customers.route-regex": "shop\\.public\\.customers",
  "iceberg.table.bronze.orders.route-regex": "shop\\.public\\.orders",
  "iceberg.table.bronze.heartbeat.route-regex": "shop\\.public\\.heartbeat",
  "iceberg.tables.evolve-schema-enabled": "false",
  "iceberg.control.topic": "iceberg-control-${env:CDC_EPOCH}",
  "iceberg.control.group-id-prefix": "connect-iceberg-sink-control-",
  "iceberg.coordinator.transactional.prefix": "iceberg-sink-",
  "iceberg.control.commit.interval-ms": "10000",
  "iceberg.control.commit.max-consecutive-failures": "10",
  "iceberg.tables.auto-create-enabled": "false",
  "iceberg.catalog.type": "rest",
  "iceberg.catalog.uri": "http://polaris:8181/api/catalog",
  "iceberg.catalog.warehouse": "lake",
  "iceberg.catalog.credential": "${file:/opt/smoke/secrets/kafka/polaris-iceberg-sink.properties:credential}",
  "iceberg.catalog.scope": "PRINCIPAL_ROLE:ALL",
  "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
  "iceberg.catalog.s3.endpoint": "http://seaweedfs:8333",
  "iceberg.catalog.s3.path-style-access": "true",
  "iceberg.catalog.s3.access-key-id": "${env:SINK_S3_ACCESS_KEY}",
  "iceberg.catalog.s3.secret-access-key": "${env:SINK_S3_SECRET_KEY}",
  "iceberg.catalog.client.region": "us-east-1"
}
