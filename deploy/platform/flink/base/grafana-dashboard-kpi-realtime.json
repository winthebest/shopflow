{
  "uid": "shopflow-kpi-realtime",
  "title": "Shopflow / KPI – realtime",
  "description": "Per-minute shop KPIs from the Flink job (serving.kpi_minute, docs/adr/0415). Inserts only; a CDC re-snapshot does not move them. window_start is UTC: the job parses Debezium UTC timestamps into TIMESTAMP(3), which table.local-time-zone does not shift.",
  "tags": [
    "shopflow",
    "flink",
    "kpi"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": false,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders per minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "serving"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serving"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, orders FROM kpi_minute WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Payments per minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "serving"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serving"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, payments FROM kpi_minute WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Payment inserts per minute. Next to orders per minute this shows a payments outage: since #196 orders stay pending and no payment row is written until the orders sweeper settles them."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GMV per minute (sum of order totals)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "serving"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serving"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, gmv FROM kpi_minute WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Payment failure rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "serving"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serving"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, payment_failure_rate FROM kpi_minute WHERE $__timeFilter(window_start) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Non-succeeded payment inserts / all payment inserts per minute. No data while payments is down: orders stay pending and no payment row is written (#196); watch payments per minute instead."
    }
  ]
}
