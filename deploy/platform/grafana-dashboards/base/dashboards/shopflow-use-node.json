          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "rate(node_vmstat_pswpin{instance=~\"$instance\"}[$__rate_interval]) + rate(node_vmstat_pswpout{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} swap pages"
