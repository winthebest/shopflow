{
  "uid": "shopflow-agent",
  "title": "Shopflow / Agent",
  "description": "The operator agent's demo deployment (agent_mode=demo): unsafe actions, task outcomes, the latency and cost SLOs (slo/agent.yaml, docs/slo/agent.md) and its LLM calls. Eval runs are not here: they go to the lab Collector and the scorer's report.",
  "tags": [
    "shopflow",
    "slo",
    "agent"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Safety",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Unsafe actions executed",
      "description": "Changes the agent executed without a valid approval or beyond the approved bounds, over the dashboard's time range. Any one pages (AgentUnsafeActionExecuted). Blocked proposals are not counted here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(agent_unsafe_actions_total{agent_mode=\"demo\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Tasks per hour by outcome",
      "description": "executed, approved (after a human approval), blocked by the guard, clarified, failed, invalid.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (agent_outcome) (increase(agent_tasks_total{agent_mode=\"demo\"}[1h]))",
          "legendFormat": "{{agent_outcome}}"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Blocked by the guard",
      "description": "Share of finished tasks the guard blocked, over the time range. Whether a block was right is an eval result (false-block rate), not a metric.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(agent_tasks_total{agent_mode=\"demo\", agent_outcome=\"blocked\"}[$__range])) / sum(increase(agent_tasks_total{agent_mode=\"demo\"}[$__range])) > 0",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "row",
      "title": "SLOs (claude-opus-5-5 demo tasks)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Error budget left, 28-day window",
      "description": "slo/agent.yaml: task-latency (95% under 120 s) and task-cost (95% at most $0.40). Local Prometheus keeps 3 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:period_error_budget_remaining:ratio{sloth_service=\"agent\"}",
          "legendFormat": "{{sloth_slo}}",
          "instant": true
        }
      ],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Bad tasks, last day",
      "description": "Share of tasks over the target in the last 24 hours. Ticket above 15% with at least 10 tasks, or above 5% over 3 days with at least 30 (docs/slo/agent.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.15
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate1d{sloth_service=\"agent\"}",
          "legendFormat": "{{sloth_slo}}",
          "instant": true
        }
      ],
      "id": 7
    },
    {
      "type": "stat",
      "title": "Spend",
      "description": "LLM spend of finished demo tasks at list prices, over the time range (all models).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(agent_task_cost_usd_sum{agent_mode=\"demo\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Task duration, p50 and p95 by model (1h)",
      "description": "Request to final decision, approval waits excluded. Target: 120 s for claude-opus-5-5. Buckets end at 600 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (increase(agent_task_duration_seconds_bucket{agent_mode=\"demo\"}[1h])))",
          "legendFormat": "p95 {{gen_ai_request_model}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_request_model) (increase(agent_task_duration_seconds_bucket{agent_mode=\"demo\"}[1h])))",
          "legendFormat": "p50 {{gen_ai_request_model}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Cost per task, claude-opus-5-5: mean and p95 (1h)",
      "description": "Target: 95% of tasks at most $0.40 (provisional, until the user's budget).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(agent_task_cost_usd_sum{agent_mode=\"demo\", gen_ai_request_model=\"claude-opus-5-5\"}[1h])) / sum(increase(agent_task_cost_usd_count{agent_mode=\"demo\", gen_ai_request_model=\"claude-opus-5-5\"}[1h])) > 0",
          "legendFormat": "mean"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(agent_task_cost_usd_bucket{agent_mode=\"demo\", gen_ai_request_model=\"claude-opus-5-5\"}[1h])))",
          "legendFormat": "p95"
        }
      ],
      "id": 10
    },
    {
      "type": "row",
      "title": "LLM calls",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Tokens per hour by type",
      "description": "gen_ai.client.token.usage (GenAI semantic conventions), summed over calls.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (gen_ai_token_type) (increase(gen_ai_client_token_usage_sum{agent_mode=\"demo\"}[1h]))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "LLM call duration, p95 by serving model (1h)",
      "description": "gen_ai.client.operation.duration. The serving model differs from the configured one after a fallback.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_response_model) (increase(gen_ai_client_operation_duration_seconds_bucket{agent_mode=\"demo\"}[1h])))",
          "legendFormat": "{{gen_ai_response_model}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Malformed tool calls, context limit hits, fallbacks per hour",
      "description": "Each costs extra turns. Fallbacks happen only in demo mode, after a refusal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(agent_tool_calls_malformed_total{agent_mode=\"demo\"}[1h]))",
          "legendFormat": "malformed tool calls"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(increase(agent_context_limit_hits_total{agent_mode=\"demo\"}[1h]))",
          "legendFormat": "context limit hits"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(increase(agent_fallbacks_total{agent_mode=\"demo\"}[1h]))",
          "legendFormat": "fallbacks"
        }
      ],
      "id": 14
    }
  ]
}
