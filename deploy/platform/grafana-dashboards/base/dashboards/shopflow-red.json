          "legendFormat": "p95",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_seconds_bucket{span_kind=\"SPAN_KIND_SERVER\", service_name=\"gateway\", http_route=\"/checkout\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ],
      "id": 5
