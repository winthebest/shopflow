{
  "catalogs": [
    {"user": "harness", "catalog": "lab_exp", "allow": "all"},
    {"user": "agent_planner", "catalog": "lab_ro", "allow": "read-only"},
    {"user": "executor", "catalog": "(lab_ops|lab_sbx)", "allow": "all"},
    {"user": "baseline_writer", "catalog": "lab_base_@RUN@", "allow": "all"},
    {"user": "observer", "catalog": "(lab_ro|lab_exp_ro|lab_sbx_ro|lab_base_ro_@RUN@)", "allow": "all"},
    {"user": "(harness|agent_planner|executor|baseline_writer|observer)", "catalog": "system", "allow": "read-only"},
    {"catalog": ".*", "allow": "none"}
  ],
  "schemas": [
    {"user": "harness", "catalog": "lab_exp", "schema": ".*", "owner": true},
    {"user": "executor", "catalog": "(lab_ops|lab_sbx)", "schema": ".*", "owner": true},
    {"user": "baseline_writer", "catalog": "lab_base_@RUN@", "schema": ".*", "owner": true},
    {"catalog": ".*", "schema": ".*", "owner": false}
  ],
  "tables": [
    {"user": "harness", "catalog": "lab_exp", "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP"]},
    {"user": "executor", "catalog": "(lab_ops|lab_sbx)", "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP"]},
    {"user": "baseline_writer", "catalog": "lab_base_@RUN@", "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP"]},
    {"user": "agent_planner", "catalog": "lab_ro", "privileges": ["SELECT"]},
    {"user": "observer", "catalog": "(lab_ro|lab_exp_ro|lab_sbx_ro|lab_base_ro_@RUN@)", "privileges": ["SELECT", "OWNERSHIP"]},
    {"user": "(harness|agent_planner|executor|baseline_writer|observer)", "catalog": "system", "privileges": ["SELECT"]},
    {"privileges": []}
  ],
  "queries": [
    {"allow": ["execute"]}
  ],
  "catalog_session_properties": [
    {"property": "(expire_snapshots_min_retention|remove_orphan_files_min_retention)", "allow": false},
    {"allow": true}
  ]
}
